{
    "manifest_version": 3,
    "name": "Temporal starter 02 — techniques",
    "version": "0.12.6",
    "description": "Draws parent/child workflow families in the Temporal UI, adds a last-event column and a retrying-activity badge, and links each row to your own log tool. Reads no payload. No backend, no host permissions, and no credential of its own — it uses the session the page already has.",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_title": "Temporal starter 02 — techniques",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://cloud.temporal.io/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "inject.js",
                "apiInject.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://cloud.temporal.io/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "world": "ISOLATED",
            "run_at": "document_start"
        }
    ]
}
