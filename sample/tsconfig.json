{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        // CommonJS, matching Temporal's own TypeScript samples: the workflow
        // bundler resolves workflowsPath through require.resolve.
        "module": "commonjs",
        "moduleResolution": "node",
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts"]
}
