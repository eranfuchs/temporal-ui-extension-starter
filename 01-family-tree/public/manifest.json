{
    "manifest_version": 3,
    "name": "Temporal starter 01 — family tree",
    "version": "0.3.1",
    "description": "Draws parent/child workflow families in the Temporal UI. No permissions, no backend, no credentials.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://cloud.temporal.io/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "inject.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://cloud.temporal.io/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "world": "ISOLATED",
            "run_at": "document_start"
        }
    ]
}
