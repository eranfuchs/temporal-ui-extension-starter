{
    "manifest_version": 3,
    "name": "Temporal starter 04 — UI goodies",
    "version": "0.1.7",
    "description": "Everything stage 03 does, plus a real JSON viewer, a NOT filter, family-aware bulk actions and column reordering for the workflow list. No backend of ours, no host permissions, and no credential of its own.",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_title": "Temporal starter 04 — UI goodies",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://cloud.temporal.io/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "inject.js",
                "apiInject.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://cloud.temporal.io/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "world": "ISOLATED",
            "run_at": "document_start"
        }
    ]
}
